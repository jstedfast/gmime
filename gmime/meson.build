version_config = configuration_data()
version_config.set('GMIME_MAJOR_VERSION', version_parts[0])
version_config.set('GMIME_MINOR_VERSION', version_parts[1])
version_config.set('GMIME_MICRO_VERSION', version_parts[2])
version_config.set('GMIME_INTERFACE_AGE', interface_age)
version_config.set('GMIME_BINARY_AGE', binary_age)
version_header = configure_file(
  input: 'gmime-version.h.in',
  output: 'gmime-version.h',
  configuration: version_config,
  install_dir: get_option('includedir') / 'gmime-@0@/gmime'.format(api_version),
)
install_headers(gmime_headers, subdir: 'gmime-@0@/gmime'.format(api_version))

libgmime = library(
  'gmime-@0@'.format(api_version),
  gmime_sources, version_header, iconv_header,
  include_directories: gmime_inc,
  dependencies: gmime_deps,
  link_whole: util_lib,
  c_args: ['-DG_LOG_DOMAIN="gmime"'],
  version: library_version,
  soversion: library_soversion,
  install: true,
)
gmime_dep = declare_dependency(
  link_with: libgmime,
  include_directories: gmime_inc,
  dependencies: gmime_deps,
)
meson.override_dependency('gmime-@0@'.format(api_version), gmime_dep)
pkgconfig.generate(
  libgmime,
  name: 'GMime',
  filebase: 'gmime-@0@'.format(api_version),
  description: 'MIME parser and utility library',
  subdirs: 'gmime-@0@'.format(api_version),
  requires: public_deps,
)

executable('gen-table', 'gen-table.c', build_by_default: false)
executable(
  'charset-map', 'charset-map.c',
  include_directories: gmime_inc,
  dependencies: gmime_deps,
  link_with: util_lib,
  build_by_default: false,
)

if have_introspection
  gmime_gir = gnome.generate_gir(
    libgmime,
    sources: [gmime_headers, gmime_sources, version_header],
    namespace: 'GMime',
    nsversion: api_version,
    identifier_prefix: 'GMime',
    symbol_prefix: ['g_mime', 'gmime'],
    includes: ['GObject-2.0', 'Gio-2.0'],
    header: 'gmime/gmime.h',
    export_packages: 'gmime-@0@'.format(api_version),
    extra_args: ['--accept-unprefixed'],
    install: true,
  )
  if have_vapi
    gnome.generate_vapi(
      'gmime-@0@'.format(api_version),
      sources: [gmime_gir[0], 'GMime-4.0-custom.vala'],
      packages: ['gio-2.0'],
      metadata_dirs: [meson.current_source_dir()],
      install: true,
    )
  endif
endif
