%bcond_with gtk_doc
%if %{with gtk_doc}
%global gtk_doc true
%else
%global gtk_doc false
%endif

Name: gmime
Version: @VERSION@
Release: 1%{?dist}
Summary: MIME parser and utility library
License: LGPL-2.1-or-later
URL: https://github.com/jstedfast/gmime
Source0: https://github.com/jstedfast/gmime/releases/download/%{version}/gmime-%{version}.tar.xz

BuildRequires: gcc
BuildRequires: meson >= 1.3.0
BuildRequires: pkgconfig(glib-2.0) >= 2.88.0
BuildRequires: pkgconfig(gobject-2.0) >= 2.88.0
BuildRequires: pkgconfig(gio-2.0) >= 2.88.0
BuildRequires: pkgconfig(gthread-2.0) >= 2.88.0
BuildRequires: pkgconfig(zlib)
BuildRequires: pkgconfig(gpgme) >= 1.6.0
BuildRequires: pkgconfig(gpg-error)
BuildRequires: pkgconfig(libidn2) >= 2.0.0
BuildRequires: pkgconfig(gobject-introspection-1.0)
BuildRequires: gnupg2
%if %{with gtk_doc}
BuildRequires: gtk-doc
%endif

%description
GMime is a set of utilities for parsing and creating messages using
the Multipurpose Internet Mail Extension (MIME).

%prep
%autosetup

%build
%meson -Dcrypto=enabled -Dlibidn=enabled -Dintrospection=enabled -Dvapi=disabled -Dgtk_doc=%{gtk_doc}
%meson_build

%check
%meson_test

%install
%meson_install

%files
%license LICENSE
%doc AUTHORS NEWS README.md PORTING.md
%{_libdir}/libgmime-@GMIME_API_VERSION@.so*
%{_libdir}/pkgconfig/gmime-@GMIME_API_VERSION@.pc
%{_libdir}/girepository-1.0/GMime-@GMIME_API_VERSION@.typelib
%{_datadir}/gir-1.0/GMime-@GMIME_API_VERSION@.gir
%{_includedir}/gmime-@GMIME_API_VERSION@/
%if %{with gtk_doc}
%{_datadir}/gtk-doc/html/gmime-@GMIME_API_VERSION@/
%endif
