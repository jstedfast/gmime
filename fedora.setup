#!/bin/bash

set -e

echo -n "Installing packages needed to build gmime..."
dnf install meson ninja-build pkgconf-pkg-config gtk-doc glib2-devel libidn2-devel zlib-devel gpgme-devel gobject-introspection-devel gnupg2

echo -n "Installing packages needed for building Vala support..."
dnf install redhat-rpm-config vala-devel

echo -n "Installing packages needed for code coverage analysis..."
dnf install lcov
